<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#07111d"><meta name="description" content="Infinity Enterprises is an independent publication and working portfolio for intelligent systems, research, technology culture, law, and civic ideas."><title>Infinity Enterprises · The September Issue</title><style>/* SHARED_CSS */</style><style>*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:#f3f0e9;color:#111d2a;font-family:Inter,ui-sans-serif,system-ui,sans-serif}h1,h2,h3,p{margin-top:0}a{color:inherit}.home .site-header{background:#07111d;color:#f4f0ea}.cover{display:grid;grid-template-columns:1.05fr .95fr;min-height:min(900px,calc(100svh - 80px));background:#07111d;color:#f5f1eb}.cover-copy{display:flex;flex-direction:column;min-width:0;padding:clamp(24px,3.4vw,56px) clamp(25px,5vw,86px) 26px}.cover-top,.cover-foot{display:flex;justify-content:space-between;gap:20px;border-bottom:1px solid #d8e0e850;padding-bottom:16px;font-size:.7rem;font-weight:750;letter-spacing:.15em;text-transform:uppercase;color:#b7c6d5}.cover-foot{border:0;border-top:1px solid #d8e0e850;padding:16px 0 0}.cover-main{margin:auto 0;padding:80px 0}.eyebrow{display:block;color:#e6a874;font-size:.77rem;font-weight:800;letter-spacing:.18em;text-transform:uppercase}.cover h1{font:400 clamp(4.4rem,7.2vw,9rem)/.93 Georgia,serif;letter-spacing:-.075em;margin:24px 0 28px}.cover h1 em{font-weight:400;color:#efb88e}.cover-main p{font:400 clamp(1.15rem,1.65vw,1.5rem)/1.5 Georgia,serif;color:#d7e2ea;max-width:660px}.cover-actions{display:flex;align-items:center;gap:26px;flex-wrap:wrap;margin-top:34px}.button{display:inline-flex;justify-content:space-between;gap:25px;padding:16px 18px;background:#eab382;color:#091827;text-decoration:none;font-size:.8rem;font-weight:850;letter-spacing:.08em;text-transform:uppercase}.button:hover{background:#fff}.quiet{font-size:.8rem;text-underline-offset:6px;letter-spacing:.08em;text-transform:uppercase}.cover-art{position:relative;min-height:500px;overflow:hidden}.cover-art img{width:100%;height:100%;position:absolute;inset:0;object-fit:cover;object-position:56% center}.cover-art:after{content:"";position:absolute;inset:0;pointer-events:none;background:linear-gradient(90deg,#07111d68,transparent 35%),linear-gradient(0deg,#07111d91,transparent 30%)}.cover-stamp{position:absolute;z-index:1;left:6%;right:6%;top:22px;display:flex;justify-content:space-between;align-items:baseline;gap:10px;color:#f7f0e9;text-shadow:0 2px 15px #000a}.cover-stamp span{font:400 clamp(3rem,6vw,7.4rem)/1 Georgia,serif;letter-spacing:-.085em}.cover-stamp small{font-size:.65rem;letter-spacing:.16em;font-weight:800}.issue-nav{display:flex;gap:24px;flex-wrap:wrap;justify-content:space-between;padding:19px clamp(24px,5vw,86px);background:#ddcfbf;color:#112331}.issue-nav a{font-size:.73rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase;text-decoration:none}.issue-nav a:hover{text-decoration:underline;text-underline-offset:5px}.section{padding:clamp(75px,8vw,130px) clamp(24px,5vw,86px)}.section-head{display:flex;align-items:end;justify-content:space-between;gap:7vw;margin-bottom:34px}.section-head h2,.closing h2{font:400 clamp(3.4rem,6vw,7rem)/.98 Georgia,serif;letter-spacing:-.07em;margin:16px 0 0}.section-head h2 em{font-weight:400;color:#a65331}.section-head>p,.head-aside{max-width:390px;color:#43515e;font-size:1.07rem;line-height:1.6}.head-aside p{margin-bottom:14px}.head-aside span{font-size:.78rem;font-weight:750;letter-spacing:.08em;text-transform:uppercase;color:#8e5435}.dark{color:#a65331}.latest{background:#f3f0e9}.signal-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.signal-card{display:flex;flex-direction:column;background:#fffaf3;text-decoration:none;border-top:3px solid #b46c43;min-height:530px;transition:transform .2s ease}.signal-card:hover{transform:translateY(-5px)}.signal-card img{width:100%;height:240px;object-fit:cover}.signal-card>div{padding:25px;display:flex;flex:1;flex-direction:column}.signal-card .label,.culture-grid span,.project-grid span{font-size:.72rem;text-transform:uppercase;letter-spacing:.15em;font-weight:850;color:#9b542f}.signal-card h3{font:400 clamp(1.9rem,2.5vw,3rem)/1.08 Georgia,serif;letter-spacing:-.045em;margin:18px 0 13px}.signal-card p{font-size:1rem;line-height:1.6;color:#465663}.signal-card .read{font-size:.77rem;font-weight:850;letter-spacing:.1em;text-transform:uppercase;margin-top:auto;padding-top:22px}.feed-note{font-size:.82rem;color:#667380;margin:16px 0 0}.research{padding:0;display:grid;grid-template-columns:1fr 1fr;background:#0a1b2b;color:#f5f1ea}.research-image{min-height:620px;position:relative}.research-image img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.research-copy{padding:clamp(65px,8vw,125px);display:flex;flex-direction:column;align-items:flex-start;justify-content:center}.research-copy h2{font:400 clamp(3.6rem,6vw,7rem)/.99 Georgia,serif;letter-spacing:-.075em;margin:23px 0}.research-copy p{font-size:1.1rem;line-height:1.7;color:#c6d5e1;max-width:560px}.line-link{display:inline-block;border-bottom:1px solid #e4ac7f;padding-bottom:6px;margin-top:23px;font-size:.8rem;letter-spacing:.1em;text-transform:uppercase;font-weight:800;text-decoration:none}.mini-story{border-top:1px solid #ffffff55;padding-top:22px;margin-top:65px;width:100%}.mini-story span{display:block;font-size:.72rem;letter-spacing:.17em;text-transform:uppercase;color:#e4ac7f;margin-bottom:10px}.mini-story a{font:400 1.45rem Georgia,serif;text-decoration:none}.mini-story a:hover{text-decoration:underline}.projects{background:#e5e0d7}.project-grid{display:grid;grid-template-columns:1.35fr .85fr;gap:18px}.project-lead,.project-side a{position:relative;overflow:hidden;color:#fff;text-decoration:none;display:flex;align-items:end;isolation:isolate;background:#162536}.project-lead{min-height:650px}.project-side{display:grid;grid-template-rows:1fr 1fr;gap:18px}.project-side a{min-height:315px}.project-grid img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:-2;transition:transform .45s ease}.project-grid a:after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,#071523ed,transparent 74%);z-index:-1}.project-grid a:hover img{transform:scale(1.04)}.project-grid a>div{padding:35px;position:relative;z-index:1}.project-grid span{color:#f1b789}.project-grid h3{font:400 clamp(2.4rem,4vw,5rem)/1 Georgia,serif;letter-spacing:-.06em;margin:12px 0}.project-grid p{font-size:1.04rem;max-width:500px}.project-grid b{font-size:.76rem;letter-spacing:.13em;text-transform:uppercase}.project-side h3{font-size:clamp(2.2rem,3vw,3.6rem)}.culture{background:#f8f6f0}.culture-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.culture-grid a{display:flex;flex-direction:column;text-decoration:none;border-top:1px solid #283c4b;padding-top:16px}.culture-grid img{width:100%;height:330px;object-fit:cover;margin-bottom:19px}.culture-grid h3{font:400 clamp(2.1rem,3vw,3.6rem)/1 Georgia,serif;letter-spacing:-.05em;margin:13px 0}.culture-grid p{color:#465663;line-height:1.6;max-width:37ch}.culture-grid b{font-size:.78rem;text-transform:uppercase;letter-spacing:.1em;margin-top:auto}.closing{display:grid;grid-template-columns:1fr 1fr;gap:8vw;background:#0b1827;color:#fff;padding:clamp(80px,9vw,140px) clamp(24px,5vw,86px)}.closing p{font:400 clamp(1.2rem,2vw,1.8rem)/1.5 Georgia,serif;color:#d1dee8}.closing a{display:block;width:max-content}@media(max-width:1050px){.cover{grid-template-columns:1fr}.cover-art{order:-1;min-height:56svh}.cover-copy{min-height:580px}.cover-stamp span{font-size:clamp(4rem,10vw,8rem)}.signal-grid,.culture-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.signal-card:last-child,.culture-grid a:last-child{grid-column:span 2}.research,.project-grid,.closing{grid-template-columns:1fr}.project-side{grid-template-columns:1fr 1fr;grid-template-rows:auto}.research-image{min-height:450px}.research-copy{padding:70px 6vw}}@media(max-width:650px){.cover-art{min-height:48svh}.cover-copy{min-height:0;padding:24px 22px}.cover-top span:last-child,.cover-foot span:last-child,.cover-stamp small{display:none}.cover-main{padding:65px 0}.cover h1{font-size:clamp(3.6rem,13vw,6rem)}.cover-stamp span{font-size:clamp(3.3rem,15vw,6.2rem)}.issue-nav{gap:15px}.issue-nav a{font-size:.68rem}.section{padding:65px 20px}.section-head{display:block}.section-head h2{font-size:clamp(3.2rem,12vw,5.5rem)}.section-head>p,.head-aside{margin-top:24px}.signal-grid,.culture-grid,.project-side{grid-template-columns:1fr}.signal-card:last-child,.culture-grid a:last-child{grid-column:auto}.signal-card{min-height:0}.signal-card img{height:225px}.research-image{min-height:340px}.research-copy{padding:65px 24px}.research-copy h2{font-size:clamp(3.1rem,11vw,5.5rem)}.project-lead{min-height:520px}.project-side a{min-height:290px}.culture-grid img{height:260px}.closing{padding:70px 24px}.closing h2{font-size:clamp(3rem,11vw,5rem)}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.signal-card,.project-grid img{transition:none}}
