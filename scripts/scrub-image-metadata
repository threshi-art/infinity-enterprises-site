#!/usr/bin/env bash
set -euo pipefail

# Read stamp text from config
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
STAMP=$(node -p "require('$SCRIPT_DIR/image-stamp.json').stamp")

if [ -z "$STAMP" ]; then
  echo "Error: stamp text not found in image-stamp.json" >&2
  exit 1
fi

# Find all image files (excluding node_modules, .git, dist)
IMAGES=$(find . -type f \( -name "*.png" -o -name "*.jpg" -o -name "*.jpeg" -o -name "*.webp" -o -name "*.gif" -o -name "*.avif" \) \
  ! -path "*/node_modules/*" \
  ! -path "*/.git/*" \
  ! -path "*/dist/*" \
  ! -path "*/build/*" | sort)

if [ -z "$IMAGES" ]; then
  echo "No image files found"
  exit 0
fi

TOTAL=$(echo "$IMAGES" | wc -l)
echo "Processing $TOTAL image files..."

PROCESSED=0
FAILED=0

while IFS= read -r img; do
  if [ ! -f "$img" ]; then
    continue
  fi
  
  # Compute pixel hash before modification
  HASH_BEFORE=$(identify -format "%#" "$img" 2>/dev/null || echo "")
  
  if [ -z "$HASH_BEFORE" ]; then
    echo "Warning: Could not compute pixel hash for $img, skipping" >&2
    ((FAILED++)) || true
    continue
  fi
  
  # Detect actual file type
  FILE_TYPE=$(file -b --mime-type "$img")
  
  # Strip all metadata except ICC profile (to preserve colors)
  # Remove EXIF, XMP, IPTC, C2PA/JUMBF
  # Use ImageMagick for files with mismatched extensions
  if [[ "$FILE_TYPE" == "image/jpeg" ]] && [[ "$img" =~ \.png$ ]]; then
    # JPEG with .png extension - use ImageMagick to strip and convert to PNG
    convert "$img" -strip "$img" 2>/dev/null || {
      echo "Error: ImageMagick failed on $img" >&2
      ((FAILED++)) || true
      continue
    }
    # Now add stamp with exiftool to the converted PNG
    exiftool -q -overwrite_original -m \
      -Copyright="$STAMP" \
      -XMP:Rights="$STAMP" \
      -IPTC:CopyrightNotice="$STAMP" \
      "$img" 2>/dev/null || {
        echo "Warning: Could not add stamp to $img after conversion" >&2
      }
  else
    # Normal case - use exiftool
    exiftool -q -overwrite_original -m \
      -all= \
      -icc_profile\<icc_profile \
      "$img" 2>/dev/null || {
        echo "Error: exiftool failed on $img" >&2
        ((FAILED++)) || true
        continue
      }
    # Add copyright stamp to supported fields
    exiftool -q -overwrite_original -m \
      -Copyright="$STAMP" \
      -XMP:Rights="$STAMP" \
      -IPTC:CopyrightNotice="$STAMP" \
      "$img" 2>/dev/null || {
        echo "Warning: Could not add stamp to $img (format may not support metadata)" >&2
      }
  fi
  
  # Verify pixel data unchanged
  HASH_AFTER=$(identify -format "%#" "$img" 2>/dev/null || echo "")
  
  if [ "$HASH_BEFORE" != "$HASH_AFTER" ]; then
    echo "ERROR: Pixel data changed for $img" >&2
    echo "  Before: $HASH_BEFORE" >&2
    echo "  After:  $HASH_AFTER" >&2
    ((FAILED++)) || true
    continue
  fi
  
  ((PROCESSED++)) || true
  
  if [ $((PROCESSED % 50)) -eq 0 ]; then
    echo "  Processed $PROCESSED/$TOTAL files..."
  fi
done <<< "$IMAGES"

echo "Done: $PROCESSED files processed successfully"
if [ $FAILED -gt 0 ]; then
  echo "Failed: $FAILED files" >&2
  exit 1
fi

exit 0
